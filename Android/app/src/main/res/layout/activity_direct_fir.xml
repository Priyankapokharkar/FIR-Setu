<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Direct FIR"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This FIR will be sent directly to the target citizen's account."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- Target User Dropdown / Search -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:hint="Search Target Citizen (Name/Email)">
            <AutoCompleteTextView
                android:id="@+id/etTargetUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:completionThreshold="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FIR Content -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="FIR Details">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFirText"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:inputType="textMultiLine"
                android:gravity="top|start" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- AI Suggest Acts -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Applicable Legal Acts"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppliedActs"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_rounded_border"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuggestActs"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="48"
                android:text="Suggest Acts"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_agenda"/>

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFileFir"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="48"
                android:text="File FIR"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/colorPrimary"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
