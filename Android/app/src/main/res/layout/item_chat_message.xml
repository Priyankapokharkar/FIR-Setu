<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Container for both User and AI Message Layouts. 
         Adapter will hide/show accordingly to create chat bubbles -->

    <!-- AI Message (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layAiMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:backgroundTint="@color/surface_color"
        android:background="@drawable/bg_rounded_border"
        android:padding="12dp"
        android:layout_marginEnd="48dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="@color/colorPrimary"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="AI Text..."
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- User Message (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:backgroundTint="@color/colorPrimary"
        android:background="@drawable/bg_rounded_border"
        android:padding="12dp"
        android:layout_marginStart="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="User Text..."
            android:textSize="15sp"/>
    </LinearLayout>

</LinearLayout>
