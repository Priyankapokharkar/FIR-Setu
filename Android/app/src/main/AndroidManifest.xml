<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/img"
        android:label="@string/app_name"
        android:roundIcon="@drawable/img"
        android:supportsRtl="true"
        android:theme="@style/Theme.LawyerApp"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <activity
            android:name=".views.LoginActivity"
            android:exported="true" />

        <activity
            android:name=".views.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LawyerApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".views.UserDashboardActivity" android:exported="false"/>
        <activity android:name=".views.FillApplicationActivity" android:exported="false"/>
        <activity android:name=".views.StatusActivity" android:exported="false"/>
        <activity android:name=".views.FirComparisonActivity" android:exported="false"/>
        <activity android:name=".views.ChatbotActivity" android:exported="false"/>
        <activity android:name=".views.ConstableDashboardActivity" android:exported="false"/>
        <activity android:name=".views.ReviewQueueActivity" android:exported="false"/>
        <activity android:name=".views.DirectFirActivity" android:exported="false"/>
        <activity android:name=".views.ReviewHistoryActivity" android:exported="false"/>
        <activity android:name=".views.SignupActivity" android:exported="false"/>

        <activity
            android:name=".views.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>